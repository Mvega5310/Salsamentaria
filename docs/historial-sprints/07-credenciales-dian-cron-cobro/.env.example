# Supabase — copia a .env.local y completa con tu proyecto
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo para el webhook de Wompi (server-side, nunca exponer al navegador)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Wompi — cobro de la suscripción SaaS (docs.wompi.co)
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=tu-integrity-secret
WOMPI_EVENTS_SECRET=tu-events-secret

# Factus — facturación electrónica DIAN
# ⚠️ Verificar FACTUS_API_URL contra la documentación real de tu cuenta
# antes de producción — ver comentario en lib/dian/factus-client.ts
FACTUS_API_URL=https://api.factus.com.co/v1
# Cifra las credenciales de CADA tenant (tenants.dian_credentials) — cada
# negocio carga las suyas en /configuracion/dian, esta llave nunca sale del
# servidor. Genera un valor largo y aleatorio (ej. openssl rand -hex 32) y
# NUNCA lo cambies una vez haya credenciales guardadas: sin la llave
# original, no se pueden volver a descifrar.
FACTUS_CONFIG_ENCRYPTION_KEY=

# Cron de cobro mensual (ver vercel.json) — Vercel envía este valor
# automáticamente en el header Authorization si lo configuras como variable
# de entorno del proyecto.
CRON_SECRET=
